generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int          @id @default(autoincrement())
  username        String
  email           String       @unique
  password        String?
  recommendations String[]     @default([])
  score           Float
  pastResumes     PastResume[] @relation("UserResumes")
  currentResumes String?
}

model PastResume {
  id              Int      @id @default(autoincrement())
  recommendations String[] @default([])
  score           Float
  userId          Int
  createdAt       DateTime @default(now())
  user            User     @relation("UserResumes", fields: [userId], references: [id])
}
